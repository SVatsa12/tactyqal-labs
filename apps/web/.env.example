# Base URL of the blog API (apps/api). Used server-side by the homepage
# "From the blog" section, the public blog pages and the admin panel. No trailing slash.
# Production: the API project's Vercel URL, e.g. https://tactyqal-api.vercel.app
API_URL=http://localhost:4000

# Public URL of this site (canonical links, sitemap, Open Graph). Production: the Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the API, called from the browser by the homepage contact form
# (so the API rate-limits each visitor by their own IP). Usually the same as API_URL.
# The API's CORS_ORIGINS must contain this site's origin (NEXT_PUBLIC_SITE_URL).
NEXT_PUBLIC_API_URL=http://localhost:4000
