# Base URL of the blog API (apps/api). Used server-side by the homepage
# "From the blog" section and the public blog pages.
API_URL=http://localhost:4000

# Public URL of this site (used for metadata / canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the API, called from the browser by the homepage contact form
# (so the API rate-limits each visitor by their own IP). Must be in the API's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:4000
