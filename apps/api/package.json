{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env src/scripts/seed.ts",
    "import:wp": "tsx --env-file=.env src/scripts/import-wordpress.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:recompute": "tsx --env-file=.env src/scripts/recompute-content.ts"
  },
  "dependencies": {
    "@prisma/client": "6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "5",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.18.2",
    "slugify": "^1.6.9",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "6",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "prisma": "6",
    "supertest": "7",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "3"
  }
}
