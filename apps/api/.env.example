# --- Database (Neon PostgreSQL) ---
# Pooled connection string (host contains "-pooler"), used by the app at runtime.
# Append &connect_timeout=15: Neon computes scale to zero and need a few seconds to wake up
# (Prisma default is 5s). The API also adds it automatically when missing.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Direct (non-pooled) connection string, used by `prisma migrate` (runs on every deploy).
# For a local Postgres, set both to the same URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Server ---
# Railway injects PORT; keep 4000 locally.
PORT=4000
# Set to production on Railway.
NODE_ENV=development
# Comma-separated list of origins allowed to call the API from a browser (no trailing slash needed).
# Production: the Vercel site URL, e.g. https://tactyqal-labs.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- First admin user (created by `pnpm --filter api db:seed`) ---
ADMIN_EMAIL=admin@tactyqal.local
ADMIN_NAME=Tactyqal Admin
ADMIN_PASSWORD=change-me-please

# --- WordPress importer (`pnpm --filter api import:wp`, 15s timeout per request) ---
WP_BASE_URL=https://tactyqal.com/blog

# --- Tests (`pnpm --filter api test`) ---
# A database the tests may WIPE: a separate Neon branch, or a separate schema on the
# direct URL (append &schema=vitest). Must not be the demo data; the tests refuse if it is.
# Leave unset to skip the API tests. Optional: TEST_DIRECT_URL if migrations need a different URL.
TEST_DATABASE_URL=
