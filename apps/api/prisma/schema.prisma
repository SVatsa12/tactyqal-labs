generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: pooled URL for the app, direct URL for migrations.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  posts        Post[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id                 String     @id @default(cuid())
  slug               String     @unique
  title              String
  excerpt            String?
  /// Sanitized HTML.
  content            String
  coverImageUrl      String?
  status             PostStatus @default(DRAFT)
  publishedAt        DateTime?
  readingTimeMinutes Int        @default(1)
  seoTitle           String?
  seoDescription     String?
  /// Original WordPress post id, so re-running the importer updates instead of duplicating.
  wpId               Int?       @unique
  author             User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId           String?
  categories         Category[]
  tags               Tag[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status, publishedAt(sort: Desc)])
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  wpId  Int?   @unique
  posts Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  wpId  Int?   @unique
  posts Post[]
}
